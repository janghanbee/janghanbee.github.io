---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";

const pageTitle = `${profile.name} | HCI Researcher at KAIST`;
const pageDescription =
  "Hanbee Jang is an HCI researcher and designer at KAIST studying virtual reality, spatial interaction, and immersive design tools.";
const homepageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://janghanbee.github.io/#person",
      name: profile.name,
      url: "https://janghanbee.github.io/",
      jobTitle: profile.role,
      email: `mailto:${profile.email}`,
      affiliation: {
        "@type": "CollegeOrUniversity",
        name: "Korea Advanced Institute of Science and Technology (KAIST)",
        alternateName: "KAIST",
        url: "https://www.kaist.ac.kr/en/",
      },
      sameAs: [
        ...profile.links.map((link) => link.href),
        "https://orcid.org/0009-0008-2887-2835",
        "https://i2dea.kaist.ac.kr/people/hanbeejang",
      ],
      knowsAbout: [
        "Human-computer interaction",
        "Virtual reality",
        "Spatial interaction",
        "Immersive design tools",
      ],
    },
    {
      "@type": "WebSite",
      "@id": "https://janghanbee.github.io/#website",
      url: "https://janghanbee.github.io/",
      name: "Hanbee Jang",
      description: pageDescription,
      author: { "@id": "https://janghanbee.github.io/#person" },
      inLanguage: "en",
    },
  ],
};
const authorNames = [profile.name, ...profile.authorAliases].filter(Boolean);
const escapeRegExp = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
const authorPattern = new RegExp(`(${authorNames.map(escapeRegExp).join("|")})`, "gi");
const splitAuthors = (authors: string) => authors.split(authorPattern);
const isProfileAuthor = (name: string) =>
  authorNames.some((authorName) => authorName.toLocaleLowerCase() === name.toLocaleLowerCase());
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/"
  jsonLd={homepageSchema}
>
  <main id="main-content" class="page" data-mode="profile">
    <section class="profile-intro" id="top" aria-labelledby="profile-name">
      <div class="profile-copy">
        <p class="eyebrow">{profile.role}</p>
        <h1 id="profile-name">{profile.name}</h1>

        <figure class="portrait-experience">
          <div class="profile-stage" id="profile-stage" data-profile-stage>
            <img
              class="stage-photo identity-portrait is-active"
              src={profile.portrait}
              alt={profile.portraitAlt}
              width="1280"
              height="960"
              loading="eager"
              data-identity-photo
            />
            {profile.modes.map((mode, index) => (
              <img
                class="stage-photo persona-photo"
                src={mode.photo}
                alt=""
                width="1280"
                height="960"
                loading="lazy"
                data-mode-photo={index}
              />
            ))}
            <button
              class="profile-reset"
              type="button"
              aria-label="Return to profile portrait"
              title="Back to profile"
              data-profile-reset
              hidden
            >×</button>
          </div>

          <div class="persona-deck" role="group" aria-label="Choose a persona">
            {profile.modes.map((mode, index) => (
              <button
                class="persona-card"
                type="button"
                aria-label={`View ${mode.label}`}
                aria-controls="profile-stage"
                aria-pressed="false"
                data-persona-card={index}
              >
                <img src={mode.photo} alt="" width="240" height="320" loading="lazy" />
                <span>{mode.cardLabel}</span>
              </button>
            ))}
          </div>

          <figcaption data-mode-caption aria-live="polite">pick a card&nbsp;✦</figcaption>
        </figure>

        <p class="intro">{profile.intro}</p>

        <address class="contact-links">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          {profile.links.map((link) => (
            <a href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a>
          ))}
        </address>
      </div>

    </section>

    <section class="content-section" aria-labelledby="education-title">
      <header class="section-title">
        <p>01</p>
        <h2 id="education-title">Education</h2>
      </header>

      <div class="education-list">
        {profile.education.map((item) => (
          <article class="education-item">
            <p>{item.period}</p>
            <div>
              <h3>{item.degree} in {item.field}</h3>
              <p class="education-institution">
                {item.institution}
                {item.affiliation && ` (${item.affiliation})`}
                {item.lab && item.advisor && (
                  <>
                    {" ("}<a href={item.lab.href} target="_blank" rel="noreferrer">{item.lab.label}</a>
                    {" · Advisor: "}<a href={item.advisor.href} target="_blank" rel="noreferrer">{item.advisor.label}</a>{")"}
                  </>
                )}
              </p>
              {item.note && <small>{item.note}</small>}
              {item.details && (
                <dl class="education-details">
                  {item.details.map((detail) => (
                    <div>
                      <dt>{detail.label}</dt>
                      <dd>
                        {detail.value}
                        {detail.links?.map((link, index) => (
                          <>
                            {index > 0 && " · "}
                            <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
                          </>
                        ))}
                      </dd>
                    </div>
                  ))}
                </dl>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section publications" aria-labelledby="publications-title">
      <header class="section-title">
        <p>02</p>
        <h2 id="publications-title">Publications</h2>
      </header>

      <div class="publication-list">
        {profile.publications.map((publication) => (
          <article class="publication-item">
            <div class="publication-meta">
              <p>{publication.year}</p>
            </div>
            <figure class="publication-figure">
              {publication.figure ? (
                <img
                  src={publication.figure}
                  alt={publication.figureAlt ?? ""}
                  width="320"
                  height="240"
                  loading="lazy"
                />
              ) : (
                <div class="figure-placeholder" aria-hidden="true">
                  <span>FIGURE</span>
                </div>
              )}
            </figure>
            <div class="publication-copy">
              <h3>
                {publication.path ? (
                  <a href={publication.path}>{publication.title}</a>
                ) : publication.title}
              </h3>
              <p class="authors">
                {splitAuthors(publication.authors).map((part) =>
                  isProfileAuthor(part) ? <mark>{part}</mark> : part
                )}
              </p>
              <p class="venue">{publication.venue}{publication.note && ` · ${publication.note}`}</p>
              {publication.links && (
                <div class="publication-links">
                  {publication.links.map((link) => (
                    <a href={link.href} target={link.href === "#" ? undefined : "_blank"} rel="noreferrer">
                      {link.label} ↗
                    </a>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <footer>
      <p>© {new Date().getFullYear()} {profile.name}</p>
      <a href="#top">Back to top ↑</a>
    </footer>
  </main>

  <script define:vars={{ modes: profile.modes, portraitAlt: profile.portraitAlt }}>
    const page = document.querySelector(".page");
    const profileStage = document.querySelector("[data-profile-stage]");
    const identityPhoto = document.querySelector("[data-identity-photo]");
    const profileReset = document.querySelector("[data-profile-reset]");
    const modeCaption = document.querySelector("[data-mode-caption]");
    const modePhotos = [...document.querySelectorAll("[data-mode-photo]")];
    const personaCards = [...document.querySelectorAll("[data-persona-card]")];
    let selectedMode = -1;

    const showProfile = () => {
      selectedMode = -1;
      page.dataset.mode = "profile";
      profileStage.classList.remove("has-selection");
      identityPhoto.classList.add("is-active");
      identityPhoto.setAttribute("alt", portraitAlt);
      profileReset.hidden = true;
      modeCaption.textContent = "pick a card\u00A0✦";

      modePhotos.forEach((photo) => {
        photo.classList.remove("is-active");
        photo.setAttribute("alt", "");
      });

      personaCards.forEach((card) => {
        card.classList.remove("is-active");
        card.setAttribute("aria-pressed", "false");
      });
    };

    const showMode = (index) => {
      selectedMode = index;
      const mode = modes[index];
      page.dataset.mode = mode.id;
      profileStage.classList.add("has-selection");
      identityPhoto.classList.remove("is-active");
      identityPhoto.setAttribute("alt", "");
      profileReset.hidden = false;
      modeCaption.textContent = mode.caption;

      modePhotos.forEach((photo, photoIndex) => {
        const isActive = photoIndex === index;
        photo.classList.toggle("is-active", isActive);
        photo.setAttribute("alt", isActive ? modes[photoIndex].photoAlt : "");
      });

      personaCards.forEach((card, cardIndex) => {
        const isActive = cardIndex === index;
        card.classList.toggle("is-active", isActive);
        card.setAttribute("aria-pressed", String(isActive));
      });
    };

    personaCards.forEach((card, index) => {
      card.addEventListener("click", () => {
        if (selectedMode === index) {
          showProfile();
          return;
        }

        showMode(index);
      });
    });

    profileReset.addEventListener("click", showProfile);
  </script>
</BaseLayout>
